              onEquip={() =>
                void equipLegendary(
                  companion
                )
              }
              onRevoke={() =>
                void revokeLegendary(
                  companion
                )
              }
            />
          )
        )}
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Legendary Ability Tests
        </Text>

        <View style={S.testBlock}>
          <Text style={S.testTitle}>
            Chrono Fox
          </Text>
          <Text style={S.small}>
            Equip Chrono Fox, then open a quiz. The live timer must begin at 7:00 and the quiz must display CHRONO FOX ACTIVE.
          </Text>
          <DevButton
            label="Open Quiz Topics"
            onPress={() =>
              router.push(
                "/(tabs)/quiz"
              )
            }
          />
        </View>

        <View style={S.testBlock}>
          <Text style={S.testTitle}>
            Celestra
          </Text>
          <Text style={S.small}>
            Equip Celestra. The streak_2 achievement is worth 20 base coins and should preview/award 25.
          </Text>
          <StatusLine
            label="Celestra preview"
            value={`${celestraRewardPreview} coins`}
          />
          <View style={S.row}>
            <DevButton
              label="Reset streak_2"
              onPress={() =>
                void resetAchievement(
                  CELESTRA_TEST_ID
                )
              }
            />
            <DevButton
              label="Trigger streak_2"
              onPress={() =>
                triggerAchievement(
                  CELESTRA_TEST_ID,
                  celestraRewardPreview
                )
              }
            />
          </View>
        </View>

        <View style={S.testBlock}>
          <Text style={S.testTitle}>
            Axolotl Oracle
          </Text>
          <Text style={S.small}>
            Equip Axolotl Oracle and run the safe preview. It does not change your real streak. Expected result with an available shield: 5 → 6. Without Axolotl: 5 → 1.
          </Text>
          <StatusLine
            label="Preview result"
            value={axolotlPreview}
          />
          <View style={S.row}>
            <DevButton
              label="Preview Missed-Day Shield"
              onPress={() =>
                void previewAxolotlTest()
              }
            />
          </View>
        </View>

        <View style={S.testBlock}>
          <Text style={S.testTitle}>
            Astral Nova
          </Text>
          <Text style={S.small}>
            Equip Astral Nova, open a quiz, and use the development Force 100% button. A certificate should grant +500 bonus coins once.
          </Text>
          <DevButton
            label="Open Quiz Topics"
            onPress={() =>
              router.push(
                "/(tabs)/quiz"
              )
            }
          />
        </View>

        <View style={S.testBlock}>
          <Text style={S.testTitle}>
            Aetherwyrm
          </Text>
          <Text style={S.small}>
            Current achievement-path test: ask_750 is worth 100 base coins and should award 120. The full all-source multiplier still needs the central coin pipeline update.
          </Text>
          <StatusLine
            label="Aetherwyrm preview"
            value={`${aetherwyrmRewardPreview} coins`}
          />
          <View style={S.row}>
            <DevButton
              label="Reset ask_750"
              onPress={() =>
                void resetAchievement(
                  AETHERWYRM_TEST_ID
                )
              }
            />
            <DevButton
              label="Trigger ask_750"
              onPress={() =>
                triggerAchievement(
                  AETHERWYRM_TEST_ID,
                  aetherwyrmRewardPreview
                )
              }
            />
          </View>
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Mecha Owl Reward Test
        </Text>

        <Text style={S.small}>
          Test achievement:{" "}
          {TEST_ACHIEVEMENT_ID}
        </Text>
        <Text style={S.small}>
          Base reward:{" "}
          {
            TEST_ACHIEVEMENT_BASE_COINS
          }{" "}
          coins
        </Text>
        <Text style={S.small}>
          With Mecha Owl:{" "}
          {
            TEST_ACHIEVEMENT_MECHA_COINS
          }{" "}
          coins
        </Text>
        <Text style={S.small}>
          Owned:{" "}
          {ownsMechaOwl
            ? "Yes"
            : "No"}
        </Text>
        <Text style={S.small}>
          Equipped:{" "}
          {mechaOwlEquipped
            ? "Yes"
            : "No"}
        </Text>
        <Text style={S.small}>
          Achievement status:{" "}
          {testAchievementUnlocked
            ? "Unlocked"
            : "Ready"}
        </Text>

        <StatusLine
          label="Provider detects Mecha Owl"
          value={
            rewardDebug
              ?.mechaOwlDetected
              ? "Yes"
              : "No"
          }
        />
        <StatusLine
          label="Provider reward preview"
          value={`${providerRewardPreview} coins`}
        />
        <StatusLine
          label="Provider token"
          value={
            rewardDebug
              ?.activeCompanionToken ||
            "None"
          }
        />

        <View style={S.row}>
          <DevButton
            label="Reset Test Achievement"
            onPress={() =>
              void resetMechaTestAchievement()
            }
          />
          <DevButton
            label="Trigger Reward Test"
            onPress={
              triggerMechaTestAchievement
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Coins
        </Text>
        <Text style={S.value}>
          {coins.toLocaleString()}
        </Text>

        <View style={S.row}>
          <DevButton
            label="+2"
            onPress={() =>
              void grantCoins(2)
            }
          />
          <DevButton
            label="+10"
            onPress={() =>
              void grantCoins(10)
            }
          />
          <DevButton
            label="+100"
            onPress={() =>
              void grantCoins(100)
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Brainteasers
        </Text>

        <View style={S.row}>
          <DevButton
            label="Reset Today"
            onPress={() =>
              void resetBrainteasersToday()
            }
          />
          <DevButton
            label="Simulate +2"
            onPress={() =>
              void simulateRiddleCorrect()
            }
          />
          <DevButton
            label="Simulate Perfect"
            onPress={() =>
              void simulateRiddleBothCorrect()
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Achievements
        </Text>

        <View style={S.row}>
          <DevButton
            label="Quiz 95%"
            onPress={
              triggerQuizAchievement95
            }
          />
        </View>

        <Text style={S.small}>
          Unlocked count:{" "}
          {
            Object.keys(
              achievements.unlocked
            ).length
          }
        </Text>

        <Text style={S.mono}>
          {JSON.stringify(
            achievements.unlocked,
            null,
            2
          )}
        </Text>
      </View>
    </ScrollView>
  );
}

function LegendaryControlCard({
  companion,
  owned,
  active,
  onGrant,
  onEquip,
  onRevoke,
}: {
  companion: CompanionItem;
  owned: boolean;
  active: boolean;
  onGrant: () => void;
  onEquip: () => void;
  onRevoke: () => void;
}) {
  return (
    <View
      style={[
        S.legendaryCard,
        active &&
          S.legendaryCardActive,
      ]}
    >
      <View style={S.legendaryTop}>
        <View style={{ flex: 1 }}>
          <Text
            style={
              S.legendaryTitle
            }
          >
            {companion.title}
          </Text>
          <Text
            style={
              S.legendaryAbility
            }
          >
            {describeAbility(
              companion
            )}
          </Text>
        </View>

        <View
          style={[
            S.statePill,
            active
              ? S.statePillActive
              : owned
              ? S.statePillOwned
              : S.statePillLocked,
          ]}
        >
          <Text
            style={
              S.statePillText
            }
          >
            {active
              ? "EQUIPPED"
              : owned
              ? "OWNED"
              : "LOCKED"}
          </Text>
        </View>
      </View>

      <StatusLine
        label="ID"
        value={companion.id}
      />
      <StatusLine
        label="Role"
        value={companion.role}
      />
      <StatusLine
        label="Ability"
        value={
          companion.ability
            ?.type ??
          "None"
        }
      />

      <View style={S.row}>
        <DevButton
          label={`Grant ${companion.shortLabel ?? companion.title}`}
          onPress={onGrant}
        />
        <DevButton
          label={`Equip ${companion.shortLabel ?? companion.title}`}
          onPress={onEquip}
        />
        <DevButton
          label="Revoke Test Ownership"
          destructive
          onPress={onRevoke}
        />
      </View>
    </View>
  );
}

function StatusLine({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <View style={S.statusRow}>
      <Text
        style={S.statusLabel}
      >
        {label}
      </Text>
      <Text
        style={S.statusValue}
      >
        {value}
      </Text>
    </View>
  );
}

function DevButton({
  label,
  onPress,
  destructive = false,
}: {
  label: string;
  onPress: () => void;
  destructive?: boolean;
}) {
  return (
    <Pressable
      style={({ pressed }) => [
        S.btn,
        destructive &&
          S.btnDestructive,
        pressed &&
          S.btnPressed,
      ]}
      onPress={onPress}
    >
      <Text
        style={[
          S.btnt,
          destructive &&
            S.btntDestructive,
        ]}
      >
        {label}
      </Text>
    </Pressable>
  );
}

