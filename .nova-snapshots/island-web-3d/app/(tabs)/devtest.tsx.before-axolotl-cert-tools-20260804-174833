const MECHA_OWL_ID = "companion:mecha_owl";
const TEST_ACHIEVEMENT_ID = "ask_1000";
const TEST_ACHIEVEMENT_BASE_COINS = 200;
const TEST_ACHIEVEMENT_MECHA_COINS = 220;

const CELESTRA_TEST_ID =
  "streak_2";
const CELESTRA_TEST_BASE = 20;

const AETHERWYRM_TEST_ID =
  "ask_750";
const AETHERWYRM_TEST_BASE = 100;

const LEGENDARY_COMPANIONS = COMPANIONS.filter(
  (companion) => !!companion.ability
);

function todayISO() {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

function todayKey(key: string) {
  return `riddles:${todayISO()}:${key}`;
}

function describeAbility(
  companion: CompanionItem
): string {
  const ability = companion.ability;

  if (!ability) return "No legendary ability";

  if (
    typeof ability.bonusPercent === "number"
  ) {
    return `+${Math.round(
      ability.bonusPercent * 100
    )}% · ${ability.note ?? ability.type}`;
  }

  if (
    typeof ability.extraMinutes === "number"
  ) {
    return `+${ability.extraMinutes} minutes · ${
      ability.note ?? ability.type
    }`;
  }

  if (
    typeof ability.bonusCoinsFlat === "number"
  ) {
    return `+${ability.bonusCoinsFlat} coins · ${
      ability.note ?? ability.type
    }`;
  }

  if (
    typeof ability.cooldownDays === "number"
  ) {
    return `Once every ${ability.cooldownDays} days · ${
      ability.note ?? ability.type
    }`;
  }

  return ability.note ?? ability.type;
}

function useToastSafe(): {
  info: (
    title: string,
    message?: string
  ) => void;
  success: (
    title: string,
    message?: string
  ) => void;
} {
  try {
    const toast =
      require("../context/ToastContext")
        .useToast?.();

    return {
      info: (title, message) =>
        (toast?.show ??
          ((text: string) =>
            Alert.alert("Notice", text)))(
          message ?? title
        ),
      success: (title, message) =>
        (toast?.success ??
          toast?.show ??
          ((text: string) =>
            Alert.alert("Success", text)))(
          message ?? title
        ),
    };
  } catch {
    return {
      info: (title, message) =>
        Alert.alert(
          "Notice",
          message ?? title
        ),
      success: (title, message) =>
        Alert.alert(
          "Success",
          message ?? title
        ),
    };
  }
}

export default function DevTestRoute() {
  if (!__DEV__) {
    return <Redirect href="/" />;
  }

  return <DevTest />;
}

function DevTest() {
  const router = useRouter();
  const toast = useToastSafe();
  const { coins, addCoins } = useCoins();
  const achievements = useAchievements();
  const {
    isOwned,
    grant,
    revoke,
  } = usePurchases();

  const {
    activeCompanionId,
    activeCompanion,
    equipCompanion,
    clearCompanion,
    isActive,
  } = useCompanion();

  const streak = useStreak();
  const [
    axolotlPreview,
    setAxolotlPreview,
  ] = useState<string>(
    "Not tested"
  );

  const ownsMechaOwl =
    isOwned(MECHA_OWL_ID);

  const mechaOwlEquipped =
    isActive(MECHA_OWL_ID);

  const testAchievementUnlocked =
    !!achievements.unlocked[
      TEST_ACHIEVEMENT_ID
    ];

  const rewardDebug =
    achievements
      .devAchievementCompanionDebug;

  const providerRewardPreview =
    achievements
      .devAchievementRewardPreview?.(
        TEST_ACHIEVEMENT_BASE_COINS,
        TEST_ACHIEVEMENT_ID
      ) ??
    TEST_ACHIEVEMENT_BASE_COINS;

  const celestraRewardPreview =
    achievements
      .devAchievementRewardPreview?.(
        CELESTRA_TEST_BASE,
        CELESTRA_TEST_ID
      ) ??
    CELESTRA_TEST_BASE;

  const aetherwyrmRewardPreview =
    achievements
      .devAchievementRewardPreview?.(
        AETHERWYRM_TEST_BASE,
        AETHERWYRM_TEST_ID
      ) ??
    AETHERWYRM_TEST_BASE;

  const ownedLegendaryCount = useMemo(
    () =>
      LEGENDARY_COMPANIONS.filter(
        (companion) =>
          isOwned(companion.id)
      ).length,
    [
      isOwned,
      // PurchasesContext returns a new isOwned callback
      // whenever its ownership map changes.
    ]
  );

  async function resetBrainteasersToday() {
    await AsyncStorage.multiRemove([
      todayKey("count"),
      todayKey("correct"),
      todayKey("bonus"),
      todayKey("done"),
    ]);

    toast.success(
      "Brainteasers reset",
      "Daily state cleared."
    );
  }

  async function grantCoins(
    amount: number,
    reason = "manual_test"
  ) {
    try {
      await addCoins(
        amount,
        reason,
        {
          source: "devtest",
        }
      );

      toast.success(
        `+${amount} coins`,
        reason
      );
    } catch (error) {
      Alert.alert(
        "Coin grant failed",
        String(error)
      );
    }
  }

  async function simulateRiddleCorrect() {
    await grantCoins(
      2,
      "brainteaser_dev_test"
    );
  }

  async function simulateRiddleBothCorrect() {
    await grantCoins(
      2,
      "brainteaser_dev_test"
    );
    await grantCoins(
      2,
      "brainteaser_dev_test"
    );
    await grantCoins(
      10,
      "brainteaser_perfect_dev_test"
    );

    await AsyncStorage.multiSet([
      [todayKey("bonus"), "1"],
      [todayKey("done"), "1"],
    ]);

    toast.success(
      "Both correct",
      "+10 bonus applied."
    );
  }

  async function grantLegendary(
    companion: CompanionItem
  ) {
    try {
      await grant(companion.id);

      toast.success(
        `${companion.title} granted`,
        `Now tap Equip ${companion.title}.`
      );
    } catch (error) {
      Alert.alert(
        "Grant failed",
        String(error)
      );
    }
  }

  async function equipLegendary(
    companion: CompanionItem
  ) {
    if (!isOwned(companion.id)) {
      toast.info(
        `${companion.title} is not owned`,
        `Tap Grant ${companion.title} first.`
      );
      return;
    }

    try {
      await equipCompanion(
        companion.id
      );

      toast.success(
        `${companion.title} equipped`,
        describeAbility(companion)
      );
    } catch (error) {
      Alert.alert(
        "Equip failed",
        String(error)
      );
    }
  }

  async function revokeLegendary(
    companion: CompanionItem
  ) {
    try {
      if (isActive(companion.id)) {
        await clearCompanion();
      }

      await revoke(companion.id);

      toast.success(
        `${companion.title} removed`,
        "Development ownership was revoked."
      );
    } catch (error) {
      Alert.alert(
        "Removal failed",
        String(error)
      );
    }
  }

  async function grantAllLegendaries() {
    try {
      await grant(
        LEGENDARY_COMPANIONS.map(
          (companion) =>
            companion.id
        )
      );

      toast.success(
        "All legendaries granted",
        "Choose one below to equip."
      );
    } catch (error) {
      Alert.alert(
        "Grant-all failed",
        String(error)
      );
    }
  }

  async function removeAllLegendaries() {
    try {
      const activeIsLegendary =
        LEGENDARY_COMPANIONS.some(
          (companion) =>
            isActive(companion.id)
        );

      if (activeIsLegendary) {
        await clearCompanion();
      }

      for (
        const companion of
        LEGENDARY_COMPANIONS
      ) {
        if (isOwned(companion.id)) {
          await revoke(companion.id);
        }
      }

      toast.success(
        "Legendary test ownership cleared",
        "All six development entitlements were removed."
      );
    } catch (error) {
      Alert.alert(
        "Remove-all failed",
        String(error)
      );
    }
  }

  async function unequipCompanion() {
    try {
      await clearCompanion();

      toast.success(
        "Companion cleared",
        "No legendary companion is equipped."
      );
    } catch (error) {
      Alert.alert(
        "Unequip failed",
        String(error)
      );
    }
  }

  async function resetMechaTestAchievement() {
    const reset =
      achievements
        .devResetAchievement;

    if (
      typeof reset !== "function"
    ) {
      toast.info(
        "Reset helper unavailable",
        "Use the current AchievementsContext test version."
      );
      return;
    }

    try {
      await reset(
        TEST_ACHIEVEMENT_ID
      );

      toast.success(
        "Test achievement reset",
        `${TEST_ACHIEVEMENT_ID} can be earned again.`
      );
    } catch (error) {
      Alert.alert(
        "Reset failed",
        String(error)
      );
    }
  }

  function triggerMechaTestAchievement() {
    if (
      testAchievementUnlocked
    ) {
      toast.info(
        "Reset required",
        "Tap Reset Test Achievement before triggering it again."
      );
      return;
    }

    const unlock =
      achievements
        .devUnlockAchievement;

    if (
      typeof unlock === "function"
    ) {
      unlock(
        TEST_ACHIEVEMENT_ID
      );
    } else {
      AchieveEmitter.emit(
        ACHIEVEMENT_EVENT,
        {
          id:
            TEST_ACHIEVEMENT_ID,
        }
      );
    }

    toast.success(
      "Achievement triggered",
      `Provider-calculated reward: ${providerRewardPreview} coins.`
    );
  }

  function triggerQuizAchievement95() {
    try {
      achievements.onQuizFinished(
        95,
        "Algebra"
      );

      toast.success(
        "Quiz achievement check",
        "onQuizFinished(95, Algebra) was sent."
      );
    } catch (error) {
      Alert.alert(
        "Quiz test failed",
        String(error)
      );
    }
  }

  async function resetAchievement(
    id: string
  ) {
    const reset =
      achievements
        .devResetAchievement;

    if (
      typeof reset !== "function"
    ) {
      toast.info(
        "Reset unavailable",
        "The current AchievementsContext does not expose its development reset helper."
      );
      return;
    }

    await reset(id);
  }

  function triggerAchievement(
    id: string,
    preview: number
  ) {
    const unlock =
      achievements
        .devUnlockAchievement;

    if (
      typeof unlock === "function"
    ) {
      unlock(id);
    } else {
      AchieveEmitter.emit(
        ACHIEVEMENT_EVENT,
        { id }
      );
    }

    toast.success(
      `${id} triggered`,
      `Provider preview: ${preview} coins.`
    );
  }

  async function previewAxolotlTest() {
    const preview =
      streak
        .devPreviewAxolotlShield;

    if (
      typeof preview !== "function"
    ) {
      toast.info(
        "Axolotl test helper unavailable",
        "Install the updated StreakContext test file first."
      );
      return;
    }

    const result =
      await preview(5);

    const summary =
      result.shieldUsed
        ? `PASS · 5 → ${result.nextCount} · shield used`
        : `NO SHIELD · 5 → ${result.nextCount} · ${
            result.hasAxolotl
              ? "cooldown unavailable"
              : "Axolotl not equipped"
          }`;

    setAxolotlPreview(summary);

    toast.success(
      "Axolotl preview complete",
      summary
    );
  }

  return (
    <ScrollView
      contentContainerStyle={
        S.wrap
      }
    >
      <Text style={S.h1}>
        Dev Test
      </Text>

      <View style={S.card}>
        <Text style={S.label}>
          Active Companion
        </Text>

        <StatusLine
          label="Equipped ID"
          value={
            activeCompanionId ??
            "None"
          }
        />
        <StatusLine
          label="Name"
          value={
            activeCompanion?.title ??
            "None"
          }
        />
        <StatusLine
          label="Role"
          value={
            activeCompanion?.role ??
            "None"
          }
        />
        <StatusLine
          label="Ability type"
          value={
            activeCompanion
              ?.ability?.type ??
            "None"
          }
        />
        <StatusLine
          label="Owned legendaries"
          value={`${ownedLegendaryCount} / ${LEGENDARY_COMPANIONS.length}`}
        />

        <View style={S.row}>
          <DevButton
            label="Grant All Legendaries"
            onPress={() =>
              void grantAllLegendaries()
            }
          />
          <DevButton
            label="Unequip Current"
            onPress={() =>
              void unequipCompanion()
            }
          />
          <DevButton
            label="Remove All Test Legendaries"
            destructive
            onPress={() =>
              void removeAllLegendaries()
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Legendary Companion Controls
        </Text>

        <Text style={S.small}>
          Grant and equip one
          legendary at a time. These
          controls are available only
          in development builds.
        </Text>

        {LEGENDARY_COMPANIONS.map(
          (companion) => (
            <LegendaryControlCard
              key={companion.id}
              companion={
                companion
              }
              owned={isOwned(
                companion.id
              )}
              active={isActive(
                companion.id
              )}
