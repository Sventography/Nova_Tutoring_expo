function Waterfall({
  unlocked,
}: {
  unlocked: boolean;
}) {
  const ref =
    useRef<THREE.Group>(
      null
    );

  useFrame(
    ({ clock }) => {
      if (!ref.current) {
        return;
      }

      ref.current.position.y =
        Math.sin(
          clock.elapsedTime * 2.8
        ) *
        0.035;
    }
  );

  return (
    <group>
      <mesh
        position={[
          0,
          0.18,
          -0.25,
        ]}
      >
        <boxGeometry
          args={[
            1.45,
            0.55,
            1.15,
          ]}
        />
