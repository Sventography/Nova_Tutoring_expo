          0,
          0.2,
          0.56,
        ]}
      >
        {[
          [-0.35, 0.34],
          [0, 0.42],
          [0.35, 0.3],
        ].map(
          ([
            x,
            height,
          ], index) => (
            <mesh
              key={index}
              position={[
                x,
                -0.28,
                0,
              ]}
            >
              <boxGeometry
                args={[
                  0.28,
                  1.25 +
                    height,
                  0.08,
                ]}
              />
              <meshStandardMaterial
                color={
                  unlocked
                    ? "#7ddcff"
                    : "#56616a"
                }
                transparent
                opacity={
                  unlocked
                    ? 0.74
                    : 0.38
                }
                emissive={
                  unlocked
                    ? "#1fa8e3"
                    : "#000000"
                }
                emissiveIntensity={
                  unlocked
                    ? 0.56
                    : 0
                }
              />
            </mesh>
          )
        )}
