{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "@lib/*": ["app/_lib/*"],
      "@components/*": ["components/*"],
      "@assets/*": ["app/assets/*"]
    },

    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,

    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "target": "es2017",
    "lib": ["esnext"],

    "types": ["react", "react-native", "expo-router"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
