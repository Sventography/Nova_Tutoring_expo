function Moonwell() {
  const water =
    useRef<THREE.Mesh>(
      null
    );

  useFrame(
    ({ clock }) => {
      if (!water.current) {
        return;
      }

      const pulse =
        1 +
        Math.sin(
          clock.elapsedTime *
            2.2
        ) *
          0.045;

      water.current.scale.set(
        pulse,
        pulse,
        pulse
      );
    }
  );

  return (
    <group scale={0.82}>
      <mesh
        position={[
          0,
          0.34,
          0,
        ]}
      >
        <cylinderGeometry
          args={[
            0.66,
            0.72,
            0.58,
            18,
