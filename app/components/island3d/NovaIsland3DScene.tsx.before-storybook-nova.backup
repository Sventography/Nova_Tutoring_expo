        <coneGeometry
          args={[
            0.7,
            0.82,
            14,
          ]}
        />
        <meshStandardMaterial
          color="#526d85"
          roughness={0.72}
        />
      </mesh>

      <group
        ref={blades}
        position={[
          0,
          1.42,
          0.5,
        ]}
      >
        <mesh>
          <cylinderGeometry
            args={[
              0.12,
              0.12,
              0.34,
              12,
            ]}
          />
          <meshStandardMaterial
            color="#6b4b35"
          />
        </mesh>

        {[0, 1, 2, 3].map(
          (index) => (
            <group
              key={index}
              rotation={[
                0,
                0,
                index *
