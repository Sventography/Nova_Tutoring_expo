function NovaResidentModel() {
  const root =
    useRef<THREE.Group>(
      null
    );

  const [
    texture,
    setTexture,
  ] = useState<
    THREE.Texture | null
  >(null);

  useEffect(() => {
    let cancelled = false;
    let loadedTexture:
      | THREE.Texture
      | null = null;

    void (async () => {
      try {
        const asset =
          Asset.fromModule(
            NOVA_ISLAND_MASCOT_ART
          );

        await asset.downloadAsync();

        const uri =
          asset.localUri ??
          asset.uri;

        loadedTexture =
          await new Promise<
            THREE.Texture
          >(
            (
              resolve,
              reject
            ) => {
              new THREE.TextureLoader().load(
                uri,
                resolve,
                undefined,
                reject
              );
            }
          );

        loadedTexture.colorSpace =
          THREE.SRGBColorSpace;

        loadedTexture.needsUpdate =
          true;

        if (!cancelled) {
          setTexture(
            loadedTexture
          );
        }
      } catch (error) {
        console.warn(
          "[Nova Island] Could not load approved Nova mascot artwork.",
          error
        );
      }
    })();

    return () => {
      cancelled = true;

      if (loadedTexture) {
        loadedTexture.dispose();
      }
    };
  }, []);

  useFrame(
    ({ clock }) => {
      if (!root.current) {
        return;
      }

      /*
       * Only a small vertical idle animation is applied. Nova never turns
       * toward the camera independently; she remains physically attached to
       * the Island and rotates only when the Island itself rotates.
       */
      root.current.position.y =
        0.9 +
        Math.sin(
          clock.elapsedTime *
            1.6
        ) *
          0.035;
    }
  );

  return (
    <group
      ref={root}
      position={[
        -1.08,
        0.9,
        0.2,
      ]}
      rotation={[
        0,
        -0.16,
        0,
      ]}
      scale={0.82}
    >
      {/* Soft ground shadow */}
      <mesh
        position={[
          0,
          0.02,
          0,
        ]}
        rotation={[
          -Math.PI / 2,
          0,
          0,
        ]}
        scale={[
          0.76,
          0.46,
          1,
        ]}
      >
        <circleGeometry
          args={[
            0.52,
            30,
          ]}
        />
        <meshBasicMaterial
          color="#020617"
          transparent
          opacity={0.22}
          depthWrite={false}
        />
      </mesh>

      {/* Small magical pedestal gives the flat mascot physical presence. */}
      <mesh
        position={[
          0,
          0.11,
          0,
        ]}
      >
        <cylinderGeometry
          args={[
            0.42,
            0.48,
            0.18,
            28,
          ]}
        />
        <meshStandardMaterial
          color="#5b2a43"
          emissive="#8b1e4a"
          emissiveIntensity={0.2}
          roughness={0.5}
        />
      </mesh>

      <mesh
        position={[
          0,
          0.22,
          0,
        ]}
        rotation={[
          -Math.PI / 2,
          0,
          0,
        ]}
      >
        <torusGeometry
          args={[
            0.38,
            0.035,
            10,
            34,
          ]}
        />
        <meshBasicMaterial
          color="#ff5c75"
          transparent
          opacity={0.8}
        />
      </mesh>

      {texture ? (
        <>
          {/*
           * The card is fixed to the Island. It deliberately does not use
           * camera.lookAt(), billboard behavior, or independent rotation.
           */}
          <mesh
            position={[
              0,
              0.92,
              0.03,
            ]}
          >
            <planeGeometry
              args={[
                1.12,
                1.38,
              ]}
            />
            <meshBasicMaterial
              map={texture}
              transparent
              alphaTest={0.03}
              side={
                THREE.DoubleSide
              }
              toneMapped={false}
            />
          </mesh>

          {/*
           * A subtle dark backing keeps Nova from disappearing completely at
           * oblique angles and makes the resident feel like a storybook
           * figurine rather than a floating UI image.
           */}
          <mesh
            position={[
              0,
              0.92,
              -0.035,
            ]}
            scale={[
              0.54,
              0.67,
              0.055,
            ]}
          >
            <capsuleGeometry
              args={[
                0.56,
                0.68,
                8,
                18,
              ]}
            />
            <meshStandardMaterial
              color="#17131a"
              emissive="#2e1020"
              emissiveIntensity={0.12}
              roughness={0.62}
            />
          </mesh>
        </>
      ) : (
        /*
         * A harmless loading placeholder is shown for only the brief moment
         * before the local image texture becomes available.
         */
        <group
          position={[
            0,
            0.86,
            0,
          ]}
        >
          <mesh
            scale={[
              0.42,
              0.52,
              0.32,
            ]}
          >
            <sphereGeometry
              args={[
                0.7,
                20,
                16,
              ]}
            />
            <meshStandardMaterial
              color="#2b1825"
              emissive="#6b1738"
              emissiveIntensity={0.18}
              roughness={0.65}
            />
          </mesh>

          <pointLight
            color="#ff6b8a"
            intensity={0.32}
            distance={2.5}
          />
        </group>
      )}

      {/* Tiny resident sparkles */}
      {[
        [
          -0.52,
          1.25,
          0.08,
          0.055,
        ],
        [
          0.5,
          1.05,
          0.08,
          0.045,
        ],
        [
          0.4,
          1.52,
          0.08,
          0.035,
        ],
      ].map(
        (
          [
            x,
            y,
            z,
            size,
          ],
          index
        ) => (
          <mesh
            key={index}
            position={[
              x,
              y,
              z,
            ]}
            rotation={[
              0,
              0,
              Math.PI / 4,
            ]}
            scale={[
              size,
              size,
              size,
            ]}
          >
            <octahedronGeometry
              args={[
                1,
                0,
              ]}
            />
            <meshBasicMaterial
              color={
                index === 1
                  ? "#67e8f9"
                  : "#ff8aa4"
              }
            />
          </mesh>
        )
      )}
    </group>
  );
}

function LunisResidentModel() {
  const root =
    useRef<THREE.Group>(
      null
    );

  const leftEar =
    useRef<THREE.Group>(
      null
    );

  const rightEar =
    useRef<THREE.Group>(
      null
    );

  const eyes =
    useRef<THREE.Group>(
      null
    );

  useFrame(
    ({ clock }, delta) => {
      const time =
        clock.elapsedTime;

      if (root.current) {
        const hop =
          Math.max(
            0,
            Math.sin(
              time * 1.3
            )
          );

        root.current.position.y =
          0.92 +
          hop * hop * 0.075;

        root.current.rotation.y =
          0.2 +
          Math.sin(
            time * 0.68
          ) *
            0.09;
      }

      if (leftEar.current) {
        leftEar.current.rotation.z =
          0.16 +
          Math.sin(
            time * 1.0
          ) *
            0.08;
      }

      if (rightEar.current) {
        rightEar.current.rotation.z =
          -0.16 +
          Math.sin(
            time * 1.0 +
              1.1
          ) *
            0.08;
      }

      if (eyes.current) {
        const cycle =
          time % 5.4;

        const blink =
          cycle > 5.16
            ? 0.08
            : 1;

        eyes.current.scale.y =
          damp(
            eyes.current.scale.y,
            blink,
            24,
            delta
          );
      }
    }
  );

  const fur = "#211e20";
  const furSoft = "#3a3337";
  const innerEar = "#f3c56b";
  const nose = "#43d7e8";

  return (
    <group
      ref={root}
      position={[
        0.28,
        0.89,
        0.82,
      ]}
      rotation={[
        0,
        0.2,
        0,
      ]}
      scale={0.28}
    >
      {/* Shadow */}
      <mesh
        position={[
          0,
          0.02,
          0,
        ]}
        rotation={[
          -Math.PI / 2,
          0,
          0,
        ]}
        scale={[
          0.76,
          0.52,
          1,
        ]}
      >
        <circleGeometry
          args={[
            0.68,
            28,
          ]}
        />
        <meshBasicMaterial
          color="#020617"
          transparent
          opacity={0.2}
