// app/utils/coins-autoboot.ts
import { Platform } from "react-native";

const KEY = "@nova/coins.v1";

// Call this from a useEffect (client-side) — NEVER at module top-level.
export async function devCoinsAutoboot(amount: string = "999999") {
  if (!__DEV__) return;

  // During web bundling/SSR, window is undefined — bail.
  if (Platform.OS === "web" && typeof window === "undefined") return;

  try {
    // Web: use localStorage (safe in browser)
    if (Platform.OS === "web") {
      try {
        window.localStorage.setItem(KEY, amount);
        return;
      } catch {}
    }

    // Native: AsyncStorage
    const AS = await import("@react-native-async-storage/async-storage");
    await AS.default.setItem(KEY, amount);
  } catch {}
}
