import React from "react";
import {
  Alert,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import AsyncStorage from "@react-native-async-storage/async-storage";
import { Redirect } from "expo-router";

import {
  ACHIEVEMENT_EVENT,
  AchieveEmitter,
  useAchievements,
} from "../context/AchievementsContext";
import { useCoins } from "../context/CoinsContext";
import { usePurchases } from "../context/PurchasesContext";
import { useCompanion } from "../context/CompanionContext";

const MECHA_OWL_ID = "companion:mecha_owl";
const TEST_ACHIEVEMENT_ID = "ask_1000";
const TEST_ACHIEVEMENT_BASE_COINS = 200;
const TEST_ACHIEVEMENT_MECHA_COINS = 220;

function todayISO() {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

function todayKey(key: string) {
  return `riddles:${todayISO()}:${key}`;
}

function useToastSafe(): {
  info: (title: string, message?: string) => void;
  success: (title: string, message?: string) => void;
} {
  try {
    const toast = require("../context/ToastContext").useToast?.();

    return {
      info: (title, message) =>
        (toast?.show ??
          ((text: string) => Alert.alert("Notice", text)))(
          message ?? title
        ),
      success: (title, message) =>
        (toast?.success ??
          toast?.show ??
          ((text: string) => Alert.alert("Success", text)))(
          message ?? title
        ),
    };
  } catch {
    return {
      info: (title, message) =>
        Alert.alert("Notice", message ?? title),
      success: (title, message) =>
        Alert.alert("Success", message ?? title),
    };
  }
}

export default function DevTestRoute() {
  if (!__DEV__) {
    return <Redirect href="/" />;
  }

  return <DevTest />;
}

function DevTest() {
  const toast = useToastSafe();
  const { coins, addCoins } = useCoins();
  const achievements = useAchievements();
  const { isOwned, grant, revoke } = usePurchases();
  const {
    activeCompanionId,
    activeCompanion,
    equipCompanion,
    clearCompanion,
  } = useCompanion();

  const ownsMechaOwl = isOwned(MECHA_OWL_ID);
  const mechaOwlEquipped =
    activeCompanionId === MECHA_OWL_ID;
  const testAchievementUnlocked =
    !!achievements.unlocked[TEST_ACHIEVEMENT_ID];

  const rewardDebug =
    achievements.devAchievementCompanionDebug;

  const providerRewardPreview =
    achievements.devAchievementRewardPreview?.(
      TEST_ACHIEVEMENT_BASE_COINS,
      TEST_ACHIEVEMENT_ID
    ) ?? TEST_ACHIEVEMENT_BASE_COINS;

  async function resetBrainteasersToday() {
    await AsyncStorage.multiRemove([
      todayKey("count"),
      todayKey("correct"),
      todayKey("bonus"),
      todayKey("done"),
    ]);

    toast.success(
      "Brainteasers reset",
      "Daily state cleared."
    );
  }

  async function grantCoins(
    amount: number,
    reason = "manual_test"
  ) {
    try {
      await addCoins(amount, reason, {
        source: "devtest",
      });

      toast.success(
        `+${amount} coins`,
        reason
      );
    } catch (error) {
      Alert.alert(
        "Coin grant failed",
        String(error)
      );
    }
  }

  async function simulateRiddleCorrect() {
    await grantCoins(2, "brainteaser_dev_test");
  }

  async function simulateRiddleBothCorrect() {
    await grantCoins(
      2,
      "brainteaser_dev_test"
    );
    await grantCoins(
      2,
      "brainteaser_dev_test"
    );
    await grantCoins(
      10,
      "brainteaser_perfect_dev_test"
    );

    await AsyncStorage.multiSet([
      [todayKey("bonus"), "1"],
      [todayKey("done"), "1"],
    ]);

    toast.success(
      "Both correct",
      "+10 bonus applied."
    );
  }

  async function grantMechaOwl() {
    try {
      await grant(MECHA_OWL_ID);

      toast.success(
        "Mecha Owl granted",
        "Now tap Equip Mecha Owl."
      );
    } catch (error) {
      Alert.alert(
        "Grant failed",
        String(error)
      );
    }
  }

  async function equipMechaOwl() {
    if (!ownsMechaOwl) {
      toast.info(
        "Mecha Owl is not owned",
        "Tap Grant Mecha Owl first."
      );
      return;
    }

    try {
      await equipCompanion(MECHA_OWL_ID);

      toast.success(
        "Mecha Owl equipped",
        "Achievement rewards should now receive +10%."
      );
    } catch (error) {
      Alert.alert(
        "Equip failed",
        String(error)
      );
    }
  }

  async function unequipCompanion() {
    try {
      await clearCompanion();

      toast.success(
        "Companion cleared",
        "No legendary companion is equipped."
      );
    } catch (error) {
      Alert.alert(
        "Unequip failed",
        String(error)
      );
    }
  }

  async function removeMechaOwlTestOwnership() {
    try {
      if (mechaOwlEquipped) {
        await clearCompanion();
      }

      await revoke(MECHA_OWL_ID);

      toast.success(
        "Mecha Owl removed",
        "Development ownership was revoked."
      );
    } catch (error) {
      Alert.alert(
        "Removal failed",
        String(error)
      );
    }
  }

  async function resetMechaTestAchievement() {
    const reset =
      achievements.devResetAchievement;

    if (typeof reset !== "function") {
      toast.info(
        "Reset helper unavailable",
        "Replace AchievementsContext.tsx with the supplied Mecha test version."
      );
      return;
    }

    try {
      await reset(TEST_ACHIEVEMENT_ID);

      toast.success(
        "Test achievement reset",
        `${TEST_ACHIEVEMENT_ID} can be earned again.`
      );
    } catch (error) {
      Alert.alert(
        "Reset failed",
        String(error)
      );
    }
  }

  function triggerMechaTestAchievement() {
    if (testAchievementUnlocked) {
      toast.info(
        "Reset required",
        "Tap Reset Test Achievement before triggering it again."
      );
      return;
    }

    const unlock =
      achievements.devUnlockAchievement;

    if (typeof unlock === "function") {
      unlock(TEST_ACHIEVEMENT_ID);
    } else {
      AchieveEmitter.emit(
        ACHIEVEMENT_EVENT,
        {
          id: TEST_ACHIEVEMENT_ID,
        }
      );
    }

    toast.success(
      "Achievement triggered",
      `Provider-calculated reward: ${providerRewardPreview} coins.`
    );
  }

  function triggerQuizAchievement95() {
    try {
      achievements.onQuizFinished(
        95,
        "Algebra"
      );

      toast.success(
        "Quiz achievement check",
        "onQuizFinished(95, Algebra) was sent."
      );
    } catch (error) {
      Alert.alert(
        "Quiz test failed",
        String(error)
      );
    }
  }

  return (
    <ScrollView
      contentContainerStyle={S.wrap}
    >
      <Text style={S.h1}>Dev Test</Text>

      <View style={S.card}>
        <Text style={S.label}>Coins</Text>
        <Text style={S.value}>
          {coins.toLocaleString()}
        </Text>

        <View style={S.row}>
          <DevButton
            label="+2"
            onPress={() =>
              void grantCoins(2)
            }
          />
          <DevButton
            label="+10"
            onPress={() =>
              void grantCoins(10)
            }
          />
          <DevButton
            label="+100"
            onPress={() =>
              void grantCoins(100)
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Mecha Owl
        </Text>

        <StatusLine
          label="Owned"
          value={ownsMechaOwl ? "Yes" : "No"}
        />
        <StatusLine
          label="Active companion"
          value={
            activeCompanionId ?? "None"
          }
        />
        <StatusLine
          label="Ability type"
          value={
            activeCompanion?.ability?.type ??
            "None"
          }
        />
        <StatusLine
          label="Ability bonus"
          value={
            activeCompanion?.ability?.bonusPercent
              ? `${Math.round(
                  activeCompanion.ability.bonusPercent *
                    100
                )}%`
              : "None"
          }
        />

        <View style={S.row}>
          <DevButton
            label="Grant Mecha Owl"
            onPress={() =>
              void grantMechaOwl()
            }
          />
          <DevButton
            label="Equip Mecha Owl"
            onPress={() =>
              void equipMechaOwl()
            }
          />
          <DevButton
            label="Unequip"
            onPress={() =>
              void unequipCompanion()
            }
          />
          <DevButton
            label="Remove Test Ownership"
            destructive
            onPress={() =>
              void removeMechaOwlTestOwnership()
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Mecha Owl Reward Test
        </Text>

        <Text style={S.small}>
          Test achievement:{" "}
          {TEST_ACHIEVEMENT_ID}
        </Text>
        <Text style={S.small}>
          Base reward:{" "}
          {TEST_ACHIEVEMENT_BASE_COINS} coins
        </Text>
        <Text style={S.small}>
          With Mecha Owl:{" "}
          {TEST_ACHIEVEMENT_MECHA_COINS} coins
        </Text>
        <Text style={S.small}>
          Status:{" "}
          {testAchievementUnlocked
            ? "Unlocked"
            : "Ready"}
        </Text>

        <StatusLine
          label="Provider detects Mecha Owl"
          value={
            rewardDebug?.mechaOwlDetected
              ? "Yes"
              : "No"
          }
        />
        <StatusLine
          label="Provider reward preview"
          value={`${providerRewardPreview} coins`}
        />
        <StatusLine
          label="Provider token"
          value={
            rewardDebug?.activeCompanionToken ||
            "None"
          }
        />

        <View style={S.row}>
          <DevButton
            label="Reset Test Achievement"
            onPress={() =>
              void resetMechaTestAchievement()
            }
          />
          <DevButton
            label="Trigger Reward Test"
            onPress={
              triggerMechaTestAchievement
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Brainteasers
        </Text>

        <View style={S.row}>
          <DevButton
            label="Reset Today"
            onPress={() =>
              void resetBrainteasersToday()
            }
          />
          <DevButton
            label="Simulate +2"
            onPress={() =>
              void simulateRiddleCorrect()
            }
          />
          <DevButton
            label="Simulate Perfect"
            onPress={() =>
              void simulateRiddleBothCorrect()
            }
          />
        </View>
      </View>

      <View style={S.card}>
        <Text style={S.label}>
          Achievements
        </Text>

        <View style={S.row}>
          <DevButton
            label="Quiz 95%"
            onPress={
              triggerQuizAchievement95
            }
          />
        </View>

        <Text style={S.small}>
          Unlocked count:{" "}
          {
            Object.keys(
              achievements.unlocked
            ).length
          }
        </Text>

        <Text style={S.mono}>
          {JSON.stringify(
            achievements.unlocked,
            null,
            2
          )}
        </Text>
      </View>
    </ScrollView>
  );
}

function StatusLine({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <View style={S.statusRow}>
      <Text style={S.statusLabel}>
        {label}
      </Text>
      <Text style={S.statusValue}>
        {value}
      </Text>
    </View>
  );
}

function DevButton({
  label,
  onPress,
  destructive = false,
}: {
  label: string;
  onPress: () => void;
  destructive?: boolean;
}) {
  return (
    <Pressable
      style={({ pressed }) => [
        S.btn,
        destructive && S.btnDestructive,
        pressed && S.btnPressed,
      ]}
      onPress={onPress}
    >
      <Text
        style={[
          S.btnt,
          destructive &&
            S.btntDestructive,
        ]}
      >
        {label}
      </Text>
    </Pressable>
  );
}

